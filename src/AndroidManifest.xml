<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.dfy.kx"
    android:versionCode="531"
    android:versionName="5.3.1">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 投屏悬浮遥控窗：别的 App 在前台时也能暂停/快进/调音量 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:label="看剧"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:allowBackup="false"
        android:supportsRtl="false"
        android:theme="@android:style/Theme.Black.NoTitleBar">

        <activity
            android:name="com.dfy.kx.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="com.dfy.kx.DlService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name="com.dfy.kx.CastService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!--
          调试用无障碍服务。刻意只注册这一个：MagicOS 11（荣耀）限制单个第三方
          App 只能注册 1 项无障碍服务，拆成多个的话在荣耀上会静默消失、用户看不到开关。
          BIND_ACCESSIBILITY_SERVICE 是系统签名权限，只有系统能绑定，普通 App 绑不了。
        -->
        <service
            android:name="com.dfy.kx.KxAccessibility"
            android:exported="true"
            android:label="看剧 · 调试辅助"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/kx_a11y" />
        </service>
    </application>
</manifest>
